## IDF Component Manager Manifest File
dependencies:
  espressif/usb_host_cdc_acm:
    version: "2.4.1"
  lvgl/lvgl:
    version: "9.2.*"
    public: true
  espressif/esp_wifi_remote:
    version: "1.6.1"
  espressif/esp_lvgl_port:
    version: "2.8.0~1"
  espressif/esp_lcd_touch_gt911:
    version: "1.2.0~2"
  espressif/esp_hosted:
    version: "2.12.9"
